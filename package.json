{
  "name": "luaconverter",
  "displayName": "LuaConverter",
  "description": "Convert Json to or from Lua table.",
  "version": "0.0.5",
  "publisher": "kouyaqi",
  "icon": "icon.png",
  "homepage": "https://github.com/walkingon/LuaConverter-vscode-ext",
  "repository": {
    "type": "github",
    "url": "https://github.com/walkingon/LuaConverter-vscode-ext"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "luaconverter.tolua",
        "title": "转换为Lua",
        "category": "LuaConverter"
      },
      {
        "command": "luaconverter.tojson",
        "title": "转换选中Table为Json",
        "category": "LuaConverter"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "luaconverter.tolua",
          "when": "resourceLangId == json",
          "group": "LuaConverter"
        },
        {
          "command": "luaconverter.tojson",
          "when": "resourceLangId == lua",
          "group": "LuaConverter"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.125.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "npm-run-all": "^1.1.3",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "lua-json": "^1.0.1"
  },
  "overrides": {
    "diff": "9.0.0",
    "serialize-javascript": "7.0.7",
    "brace-expansion": "5.0.8"
  }
}
